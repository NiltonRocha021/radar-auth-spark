# =============================================================
# Signal Radar — variáveis para `wrangler dev` (execução local
# no runtime workerd, idêntico ao de produção).
#
# Copie para `.dev.vars` (NUNCA commitar) e preencha valores reais.
# Apenas variáveis SERVER-SIDE entram aqui — variáveis com prefixo
# VITE_ continuam em `.env` (bundle do cliente).
#
# Em produção/staging, registre cada uma com:
#   wrangler secret put <NAME> --env <staging|production>
# =============================================================

# ----- Supabase (server-side) ---------------------------------
# Service role key — bypassa RLS, NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ----- Lovable / Email ----------------------------------------
LOVABLE_API_KEY=<lovable-api-key>
LOVABLE_SEND_URL=
EMAIL_QUEUE_CRON_SECRET=<random-256-bit-hex>

# ----- CoinGecko ----------------------------------------------
# Chave Demo gratuita — obtida em coingecko.com/en/api
# Nunca coloque uma chave real neste arquivo de exemplo. Se uma chave foi exposta, revogue-a no provedor e gere outra.
COINGECKO_API_KEY=<coingecko-demo-api-key>

# ----- Cache TTLs (Cloudflare caches.default) -----------------
# Mínimo 30s para evitar 429 na CoinGecko free/demo tier.
CACHE_TTL_PRICES_SECONDS=30
CACHE_TTL_SIGNALS_SECONDS=30
CACHE_TTL_SENTIMENT_SECONDS=60

# ----- Ambiente -----------------------------------------------
NODE_ENV=development