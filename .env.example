# =============================================================
# Signal Radar — variáveis de ambiente obrigatórias
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do .env com valores reais — apenas .env.example.
# =============================================================

# ----- Supabase -----------------------------------------------
# Obter em: supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# ----- Backend API --------------------------------------------
# URL base da API REST (ex: https://api.seudominio.com).
# OBRIGATÓRIA em produção — sem ela o cliente REST é bloqueado.
VITE_API_BASE_URL=http://localhost:3001/api

# URL do WebSocket (wss:// em produção, ws:// em desenvolvimento).
VITE_API_WS_URL=ws://localhost:3001

# ----- Bot4x --------------------------------------------------
# Habilita o motor REAL do Bot4x (true | false).
# Quando false ou ausente, o app roda inteiramente em modo DEMO
# (simulação client-side, sem ordens reais).
VITE_BOT4X_REAL_ENABLED=false
